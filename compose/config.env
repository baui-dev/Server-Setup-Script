# =============================================================================
# CENTRALIZED DOCKER COMPOSE CONFIGURATION
# =============================================================================
# This file is the single source of truth for all stack configurations.
# Reference variables in any compose file with ${VARIABLE_NAME} syntax.
# Copy this file to .env in the same directory as your compose files,
# or pass it explicitly: docker compose --env-file config.env up
# =============================================================================

# -----------------------------------------------------------------------------
# GLOBAL SETTINGS
# -----------------------------------------------------------------------------
TZ=Europe/London                  # Timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
DOCKER_DATA=/opt/docker           # Canonical compose path root used by services/*.yaml
PUID=1000                         # User ID for file permissions (run: id -u)
PGID=1000                         # Group ID for file permissions (run: id -g)

# -----------------------------------------------------------------------------
# BASE PATHS
# -----------------------------------------------------------------------------
BASE_DATA=/opt/docker             # Root directory for all container data/config volumes
DOWNLOADS_DIR=/mnt/media/downloads  # Shared download directory
MEDIA_DIR=/mnt/media              # Shared media root (movies, tv, music, etc.)
MOVIES_DIR=/mnt/media/movies      # Movies directory
TV_DIR=/mnt/media/tv              # TV shows directory
MUSIC_DIR=/mnt/media/music        # Music directory
BASE_DOMAIN=example.com           # Canonical reverse-proxy domain variable used by services/*.yaml
BOOKS_DIR=/mnt/media/books        # Books/ebooks directory
DEFAULT_NETWORK=proxy             # Canonical Docker network variable used by services/*.yaml
PHOTOS_DIR=/mnt/media/photos      # Photos directory
GAMES_DIR=/mnt/media/games        # Games directory

PORT_PYLOAD_CLICKNLOAD=9666       # pyLoad click'n'load endpoint
# -----------------------------------------------------------------------------
# DOMAIN / NETWORKING
# -----------------------------------------------------------------------------
PORT_CHANGEDETECTION=5001         # changedetection.io web UI
DOMAIN=example.com                # Base domain for your services
DOCKER_NETWORK=proxy              # Docker network name for reverse proxy integration

# -----------------------------------------------------------------------------
# VPN SETTINGS (Gluetun)
# -----------------------------------------------------------------------------
PORT_GLANCE=8084                  # Glance dashboard
VPN_SERVICE_PROVIDER=mullvad      # VPN provider (mullvad, nordvpn, expressvpn, etc.)
VPN_TYPE=wireguard                # VPN type (wireguard or openvpn)
WIREGUARD_PRIVATE_KEY=            # Your WireGuard private key
WIREGUARD_ADDRESSES=              # Your WireGuard assigned IP (e.g. 10.64.222.21/32)
VPN_SERVER_CITIES=Amsterdam       # Preferred VPN server city/location
UPDATER_PERIOD=24h                # How often to refresh VPN server list
VPN_PORT_FORWARDING=on            # Enable port forwarding if your VPN supports it

# -----------------------------------------------------------------------------
# DATABASE CREDENTIALS (shared)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=changeme_postgres  # PostgreSQL password (change this!)
POSTGRES_USER=postgres               # PostgreSQL user
POSTGRES_DB=app                      # Default database name
MYSQL_ROOT_PASSWORD=changeme_mysql   # MySQL root password (change this!)
MYSQL_PASSWORD=changeme_mysql_user   # MySQL user password
MYSQL_USER=appuser                   # MySQL user
MYSQL_DATABASE=app                   # MySQL database name
REDIS_PASSWORD=changeme_redis        # Redis password (change this!)

# -----------------------------------------------------------------------------
# SECRET KEYS (generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32
APP_KEY=changeme_generate_with_openssl_rand_hex_32

